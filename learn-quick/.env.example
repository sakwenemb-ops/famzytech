# ── Database ──
DATABASE_URL="postgresql://lq:lq@localhost:5432/learnquick"

# ── Auth.js ──  generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Optional: Google sign-in (button is hidden when unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Uploaded files ──
# "local" saves files on this server's disk in STORAGE_DIR (default ./storage)
STORAGE_DRIVER="local"
STORAGE_DIR=""
# Encrypts ID documents and certificates. Required in production. Generate with: openssl rand -base64 32
# Never change it once files exist, or they can no longer be opened.
FILE_ENCRYPTION_KEY=""

# ── Email (Resend). Unset = codes are printed in the server console ──
RESEND_API_KEY=""
EMAIL_FROM="Learn Quick <no-reply@yourdomain.com>"

# ── SMS (Africa's Talking). Unset = codes are printed in the server console ──
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# ── Seed ──
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ── Payments ──
# "sandbox" = pretend payments for development (refused on a live site); "campay" = real Mobile Money
PAYMENT_PROVIDER="sandbox"
# Campay: https://demo.campay.net while testing, https://www.campay.net when live
CAMPAY_BASE_URL="https://demo.campay.net"
# The app's API username and password from the Campay dashboard (or a permanent access token instead)
CAMPAY_USERNAME=""
CAMPAY_PASSWORD=""
CAMPAY_ACCESS_TOKEN=""
# Webhook key from the Campay dashboard; set the webhook URL there to https://YOUR-SITE/api/webhooks/campay
CAMPAY_WEBHOOK_KEY=""

# ── Live classroom (video calls) ──
# A TURN server relays calls on networks that block direct connections. Strongly recommended in production.
TURN_URL=""          # e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=""
TURN_CREDENTIAL=""
# Or give the full list as JSON instead: ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'

# ── Translation library: AI grading with Claude ──
# Unset = sentences and paragraphs get a basic similarity score instead
ANTHROPIC_API_KEY=""
# GRADER_MODEL="claude-opus-5-5"
# LIBRARY_GRADER="basic"   # turn AI grading off even when a key is set

# ── Tests only (ignored in production): every one-time code is this value ──
# OTP_FIXED_CODE="123456"
# RATE_LIMITS="off"   # turns off sign-in and message limits on a local computer only
