# Copy to deploy/.env and fill in. Never commit deploy/.env.

# ── Your address ──
DOMAIN=learnquick.cm
NEXT_PUBLIC_SITE_URL=https://learnquick.cm

# ── Database password (letters and digits only). Generate: openssl rand -hex 24 ──
POSTGRES_PASSWORD=

# ── Secrets. Generate each with: openssl rand -base64 32 ──
AUTH_SECRET=
# Encrypts ID documents. Keep a copy somewhere safe: without it, uploaded documents can't be opened.
FILE_ENCRYPTION_KEY=

# ── First admin account (created by the seed command) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Email (Resend) and SMS (Africa's Talking) ──
RESEND_API_KEY=
EMAIL_FROM="Learn Quick <no-reply@learnquick.cm>"
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── Payments (Campay) ──
PAYMENT_PROVIDER=campay
CAMPAY_BASE_URL=https://www.campay.net
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=

# ── Video calls: TURN server (strongly recommended) ──
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Optional ──
ANTHROPIC_API_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
