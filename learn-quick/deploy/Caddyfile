# Caddy gets and renews the HTTPS certificate for your domain by itself.
{$DOMAIN} {
	encode zstd gzip
	# Live updates (Server-Sent Events) are passed through without buffering
	reverse_proxy app:3000
}

# Visitors typing www. are sent to the main address
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
